        </ul>
        <a href="/bmd.asp#notify" class="ehw-bmd__btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          Tell me when it’s ready
        </a>
      </div>
      <!-- Predicted BMD by age, straight from lib/bmd.js -->
      <figure class="ehw-bmd__chart">
        <figcaption class="ehw-bmd__chart-cap">
          <strong>The model behind it</strong>
          <span>Predicted BMD by age at 158&nbsp;cm, for three body weights</span>
        </figcaption>
        <div class="ehw-bmd__plot">
          <svg class="ehw-bmd__svg" viewBox="0 0 640 430" role="img" preserveAspectRatio="xMidYMid meet"
               aria-label="Line chart: predicted bone mineral density falls with age, plotted for three body weights against the WHO Normal, Osteopenia and Osteoporosis bands. The 45 kg curve crosses into Osteopenia around age 70.">
            <!-- WHO classification bands — thresholds from lib/bmd.js -->

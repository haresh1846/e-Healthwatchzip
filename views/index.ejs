<script>
// Reveal sections as they scroll into view. Each hidden starting state lives
// behind an --animate class that only this script adds, so with JavaScript off
// everything renders normally instead of staying invisible.
(function () {
  var targets = [
    { el: document.querySelector('.ehw-steps'),     cls: 'ehw-steps--animate' },
    { el: document.querySelector('.ehw-bmd-wrap'),  cls: 'ehw-bmd-wrap--animate' }
  ].filter(function (t) { return t.el; });
  if (!targets.length) return;

  targets.forEach(function (t) { t.el.classList.add(t.cls); });

  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (t) { t.el.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-visible');
      io.unobserve(e.target);
    });
  }, { threshold: 0.25 });
  targets.forEach(function (t) { io.observe(t.el); });
})();
</script>


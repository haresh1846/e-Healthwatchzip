<!-- ═══════════════════════════════════════════════════════════
     HOW IT WORKS
════════════════════════════════════════════════════════════════ -->
<section class="ehw-sec ehw-sec--white" style="position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at top right, rgba(251,207,232,0.18), transparent 60%);pointer-events:none"></div>
  <div class="ehw-sec__inner" style="position:relative;z-index:1">
    <div class="ehw-sec__head">
      <p class="ehw-sec__label">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Simple to use
      </p>
      <h2>Your health journey in 3 steps</h2>
      <p>No jargon, no barriers. Just clear, personalised health insights at your fingertips.</p>
    </div>
    <div class="ehw-steps">
      <a class="ehw-step ehw-step--rose" href="#topics">
        <div class="ehw-step__icon ehw-step__icon--rose">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="ehw-step__num">01</span>
        </div>
        <div class="ehw-step__body">
          <h3>Explore Your Topics</h3>
          <p>Browse gynaecology, menopause, pregnancy, and bone health guides — all evidence-based and written in plain language.</p>
          <span class="ehw-step__cue">Browse the guides
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </div>
      </a>
      <a class="ehw-step ehw-step--amber" href="/forecasting.asp">
        <div class="ehw-step__icon ehw-step__icon--amber">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span class="ehw-step__num">02</span>
        </div>
        <div class="ehw-step__body">
          <h3>Run a Prediction</h3>
          <p>Enter your AMH level or BMD data into our calculators and get an instant, personalised forecast in seconds.</p>
          <span class="ehw-step__cue">Start a forecast
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </div>
      </a>
      <a class="ehw-step ehw-step--green" href="#sample-result">
        <div class="ehw-step__icon ehw-step__icon--green">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span class="ehw-step__num">03</span>
        </div>
        <div class="ehw-step__body">
          <h3>Understand Your Results</h3>
          <p>Receive clear insights and guidance with recommended next steps tailored specifically to you.</p>
          <span class="ehw-step__cue">See a sample result
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </div>
      </a>
    </div>
    <div class="ehw-steps__ctas">
      <a href="/forecasting.asp" class="ehw-steps__btn-p">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Get Started at &#8377;<%= priceRupees %>
      </a>
      <span class="ehw-steps__btn-s" style="cursor:default">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Takes less than 2 minutes
      </span>
    </div>
  </div>
</section>


<%- include('partials/header') %>

<!-- ═══════════════════════════════════════════════════════════
     HERO SECTION
════════════════════════════════════════════════════════════════ -->
<section class="ehw-hero">
  <div class="ehw-hero__blob ehw-hero__blob--1"></div>
  <div class="ehw-hero__blob ehw-hero__blob--2"></div>
  <div class="ehw-hero__blob ehw-hero__blob--3"></div>

  <div class="ehw-hero__inner">
    <!-- Text -->
    <div>
      <div class="ehw-hero__badge">
        <span class="ehw-hero__badge-dot"></span>
        Trusted Women's Health Platform
      </div>
      <h1>
        Predictive health insights with
        <span class="grad">warmth &amp; precision.</span>
      </h1>
      <p class="ehw-hero__desc">
        Empowering women through advanced mathematical modelling.
        Because understanding your health journey shouldn't feel clinical—it should feel deeply personal.
      </p>
      <div class="ehw-hero__btns">
        <a href="/forecasting.asp" class="ehw-hero__btn-p">
          Forecast Menopause
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/bmd.asp" class="ehw-hero__btn-s">BMD Calculator <span class="ehw-soon-tag">Soon</span></a>
      </div>
      <div class="ehw-hero__social">
        <div class="ehw-hero__avatars">
          <div class="ehw-hero__avatar">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
        </div>
        <p>Built on peer-reviewed AMH research &middot; your result stays private</p>
      </div>
    </div>

    <!-- Image + Deal -->
    <div class="ehw-hero__img-wrap">
      <img src="/images/warm-hero.jpg" alt="Warm wellness illustration for women's health" class="ehw-hero__img">
      <div class="ehw-hero__deal">
        <div class="ehw-hero__deal-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L9.27 9l-6.27.73 4.5 4.27-1.09 6.27L12 17l5.59 3.27-1.09-6.27 4.5-4.27-6.27-.73z"/></svg>
        </div>
        <div>
          <p class="ehw-hero__deal-label">Limited Offer</p>
          <div class="ehw-hero__deal-price">
            <strong>&#8377;<%= priceRupees %></strong>
            <del>&#8377;<%= listPriceRupees %></del>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="ehw-wave">
    <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,111.47,196.59,101.4,239.5,94.9,282.7,80.8,321.39,56.44Z" class="sf"></path>
    </svg>
  </div>
</section>


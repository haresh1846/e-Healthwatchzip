            <rect x="52" y="259.97" width="538" height="105.71" fill="#FEF3C7"/>
            <rect x="52" y="365.68" width="538" height="22.32" fill="#FFE4E6"/>
            <text class="ehw-bmd__band-tag" x="60" y="252.97">Normal</text>
            <text class="ehw-bmd__band-tag" x="60" y="358.68">Osteopenia</text>
            <text class="ehw-bmd__band-tag" x="60" y="382">Osteoporosis</text>
            <!-- WHO thresholds -->
            <line class="ehw-bmd__thresh" x1="52" y1="259.97" x2="590" y2="259.97"/>
            <text class="ehw-bmd__thresh-tag" x="45" y="262.97" text-anchor="end">0.738</text>
            <line class="ehw-bmd__thresh" x1="52" y1="365.68" x2="590" y2="365.68"/>
            <text class="ehw-bmd__thresh-tag" x="45" y="368.68" text-anchor="end">0.558</text>
            <line class="ehw-bmd__axis" x1="52" y1="18" x2="52" y2="388"/>
            <line class="ehw-bmd__axis" x1="52" y1="388" x2="590" y2="388"/>
            <text class="ehw-bmd__tick" x="52" y="405" text-anchor="middle">30</text>
            <text class="ehw-bmd__tick" x="159.6" y="405" text-anchor="middle">40</text>
            <text class="ehw-bmd__tick" x="267.2" y="405" text-anchor="middle">50</text>
            <text class="ehw-bmd__tick" x="374.8" y="405" text-anchor="middle">60</text>
            <text class="ehw-bmd__tick" x="482.4" y="405" text-anchor="middle">70</text>
            <text class="ehw-bmd__tick" x="590" y="405" text-anchor="middle">80</text>
            <text class="ehw-bmd__tick" x="45" y="344.02" text-anchor="end">0.6</text>
            <text class="ehw-bmd__tick" x="45" y="226.56" text-anchor="end">0.8</text>
            <text class="ehw-bmd__tick" x="45" y="109.1" text-anchor="end">1.0</text>
            <text class="ehw-bmd__axis-title" x="321" y="424" text-anchor="middle">Age (years)</text>
            <text class="ehw-bmd__axis-title" x="14" y="203" text-anchor="middle" transform="rotate(-90 14 203)">BMD (g/cm&#178;)</text>
            <!-- Model output at 158 cm, HAL 98 mm, NSA 127&#176;, body weight varied -->
            <polyline class="ehw-bmd__line ehw-bmd__line--1" points="52,118.6 73.52,130.82 95.04,142.04 116.56,152.43 138.08,162.07 159.6,171.05 181.12,179.51 202.64,187.38 224.16,194.84 245.68,201.83 267.2,208.46 288.72,214.75 310.24,220.74 331.76,226.43 353.28,231.84 374.8,237 396.32,242 417.84,246.75 439.36,251.28 460.88,255.68 482.4,259.85 503.92,263.9 525.44,267.84 546.96,271.6 568.48,275.18 590,278.7" fill="none" stroke="#8A7F79" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

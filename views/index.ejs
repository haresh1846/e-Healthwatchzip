          <li><span class="ehw-bmd__swatch" style="background:#5C534E"></span>62&nbsp;kg</li>
          <li><span class="ehw-bmd__swatch" style="background:#332C29"></span>80&nbsp;kg</li>
        </ul>
        <details class="ehw-bmd__data">
          <summary>View the numbers</summary>
          <table>
            <caption>Predicted BMD (g/cm&#178;) at 158&nbsp;cm, HAL 98&nbsp;mm, NSA 127&#176;</caption>
            <thead>
              <tr><th scope="col">Age</th><th scope="col">45&nbsp;kg</th><th scope="col">62&nbsp;kg</th><th scope="col">80&nbsp;kg</th></tr>

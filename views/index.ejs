            <polyline class="ehw-bmd__line ehw-bmd__line--2" points="52,78.2 73.52,91.24 95.04,103.28 116.56,114.43 138.08,124.77 159.6,134.4 181.12,143.39 202.64,151.85 224.16,159.77 245.68,167.29 267.2,174.4 288.72,181.15 310.24,187.55 331.76,193.6 353.28,199.42 374.8,204.94 396.32,210.28 417.84,215.33 439.36,220.21 460.88,224.91 482.4,229.37 503.92,233.72 525.44,237.89 546.96,241.94 568.48,245.81 590,249.57" fill="none" stroke="#5C534E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <text class="ehw-bmd__series-tag" x="597" y="253.57">62 kg</text>
            <polyline class="ehw-bmd__line ehw-bmd__line--3" points="52,44.02 73.52,57.82 95.04,70.56 116.56,82.31 138.08,93.17 159.6,103.33 181.12,112.85 202.64,121.78 224.16,130.17 245.68,138.1 267.2,145.62 288.72,152.73 310.24,159.48 331.76,165.88 353.28,171.99 374.8,177.86 396.32,183.44 417.84,188.79 439.36,193.96 460.88,198.89 482.4,203.65 503.92,208.23 525.44,212.63 546.96,216.86 568.48,220.97 590,224.97" fill="none" stroke="#332C29" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <text class="ehw-bmd__series-tag" x="597" y="228.97">80 kg</text>

<%
/**
 * Button / action link.
 * @param {string} label
 * @param {string} href
 * @param {'primary'|'secondary'|'quiet'} [variant='primary']
 * @param {boolean} [block=false]
 */
const _variant = locals.variant || 'primary';
const _block = locals.block ? ' btn--block' : '';
%><a class="btn btn--<%= _variant %><%= _block %>" href="<%= href %>"><%= label %></a>

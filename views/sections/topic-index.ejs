<%
/** @param {import('../../content/schema').TopicIndexSection} s */
%><section class="section section--sunken">
  <div class="container">
    <%- include('../components/section-head', { eyebrow: s.eyebrow, heading: s.heading, body: s.body }) %>
    <div class="topic-list">
      <% s.topics.forEach(function (topic) { %>
        <a class="topic" href="<%= topic.href %>">
          <span class="topic__title"><%= topic.title %></span>
          <span class="topic__body"><%= topic.body %></span>
          <span class="topic__cue" aria-hidden="true">Read &rarr;</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%
/** @param {import('../../content/schema').HeroSection} s */
%><section class="hero">
  <div class="container hero__grid">
    <div>
      <span class="eyebrow"><%= s.eyebrow %></span>
      <h1 class="hero__headline">
        <%= s.headline %><% if (s.headlineAccent) { %><em><%= s.headlineAccent %></em><% } %>
      </h1>
      <p class="hero__body"><%= s.body %></p>

      <div class="hero__actions">
        <% s.actions.forEach(function (action) { %>
          <%- include('../components/button', { label: action.label, href: action.href, variant: action.variant }) %>
        <% }); %>
      </div>

      <% if (s.assurances && s.assurances.length) { %>
        <ul class="hero__assurances">
          <% s.assurances.forEach(function (item) { %><li><%= item %></li><% }); %>
        </ul>
      <% } %>
    </div>

    <% if (s.specimen) { %>
      <div><%- include('../components/specimen', { data: s.specimen }) %></div>
    <% } %>
  </div>
</section>

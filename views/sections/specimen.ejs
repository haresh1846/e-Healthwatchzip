<%
/** @param {import('../../content/schema').SpecimenSection} s */
%><section class="section">
  <div class="container showcase__grid">
    <div>
      <%- include('../components/section-head', { eyebrow: s.eyebrow, heading: s.heading, body: s.body }) %>
      <% if (s.action) { %>
        <div class="showcase__action">
          <%- include('../components/button', { label: s.action.label, href: s.action.href, variant: s.action.variant }) %>
        </div>
      <% } %>
    </div>
    <div><%- include('../components/specimen', { data: s.specimen, prose: true }) %></div>
  </div>
</section>

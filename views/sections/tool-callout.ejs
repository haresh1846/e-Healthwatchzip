<%
/** @param {import('../../content/schema').ToolCalloutSection} s */
%><section class="section section--sunken">
  <div class="container tool__grid">
    <div>
      <%- include('../components/section-head', { eyebrow: s.eyebrow, heading: s.heading, body: s.body }) %>
      <ul class="tool__points">
        <% s.points.forEach(function (point) { %><li><%= point %></li><% }); %>
      </ul>
      <%- include('../components/button', { label: s.action.label, href: s.action.href, variant: s.action.variant }) %>
    </div>

    <div class="scale">
      <h3 class="scale__heading"><%= s.scale.heading %></h3>
      <% s.scale.bands.forEach(function (band) { %>
        <div class="scale__band">
          <%- include('../components/badge', { level: band.level, label: band.label }) %>
          <span class="scale__range"><%= band.range %></span>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%
/** @param {import('../../content/schema').ContactSection} s */
%><section class="section section--sunken" id="contact">
  <div class="container contact__grid">
    <div>
      <%- include('../components/section-head', { eyebrow: s.eyebrow, heading: s.heading, body: s.body }) %>
      <dl class="contact__details">
        <% s.details.forEach(function (detail) { %>
          <div class="contact__detail">
            <dt><%= detail.label %></dt>
            <dd><%= detail.value %></dd>
          </div>
        <% }); %>
      </dl>
    </div>

    <form method="post" action="/">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="validate1" value="T">

      <% if (locals.contactSuccess) { %>
        <p class="form__success" role="status"><%= s.form.success %></p>
      <% } %>

      <div class="form__row">
        <%- include('../components/field', { id: 'c-fname', name: 'fname', label: s.form.fname }) %>
        <%- include('../components/field', { id: 'c-lname', name: 'lname', label: s.form.lname }) %>
      </div>
      <%- include('../components/field', { id: 'c-email', name: 'email', label: s.form.email, type: 'email' }) %>
      <%- include('../components/field', { id: 'c-phone', name: 'phone', label: s.form.phone, type: 'tel' }) %>
      <%- include('../components/field', { id: 'c-msg', name: 'comment', label: s.form.message, textarea: true }) %>

      <button type="submit" class="btn btn--primary btn--block"><%= s.form.submit %></button>
    </form>
  </div>
</section>

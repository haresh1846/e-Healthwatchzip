<%
/** @param {import('../../content/schema').StatStripSection} s */
%><section class="stat-strip">
  <div class="container">
    <dl class="stat-strip__list">
      <% s.stats.forEach(function (stat) { %>
        <div class="stat-strip__item">
          <dt class="u-visually-hidden"><%= stat.label %></dt>
          <dd>
            <span class="stat-strip__value"><%= stat.value %></span>
            <span class="stat-strip__label" aria-hidden="true"><%= stat.label %></span>
          </dd>
        </div>
      <% }); %>
    </dl>
  </div>
</section>

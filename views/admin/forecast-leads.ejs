<%- include('partials/header', {
  pageTitle: 'Forecast Leads',
  activeTab: 'forecast-leads',
  userCount: locals.userCount || 0,
  orderCount: locals.orderCount || 0,
  resultCount: locals.resultCount || 0,
  bmdCount: locals.bmdCount || 0,
  leadCount: leads.length
}) %>

<div class="adm-body">

  <div class="adm-stats">
    <div class="adm-stat">
      <div class="adm-stat-label">Total Gate Hits</div>
      <div class="adm-stat-value"><%= leads.length %></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-label">With Email on File</div>
      <div class="adm-stat-value"><%= leads.filter(function(l){ return l.consumer_email; }).length %></div>
    </div>
  </div>

  <div class="adm-section-header">
    <h1 class="adm-section-title">Forecast Leads</h1>
    <div class="adm-section-spacer"></div>
    <div class="adm-search">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="search-input" placeholder="Search by name or email…" oninput="filterTable()" autocomplete="off">
    </div>
    <a href="/admin/forecast-leads?export=csv" class="adm-export">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Export CSV
    </a>
  </div>

  <p style="font-size:13px;color:var(--stone);margin:-8px 0 20px;">
    Visitors whose intake values gave a forecast age at or before their current age — the calculator had nothing forward-looking to offer, so they were routed to /already-menopausal instead of the paywall. No order or paid result was ever created for these.
  </p>

  <div class="adm-table-wrap">
    <table class="adm-table" id="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Consumer</th>
          <th class="hide-mobile">Profile</th>
          <th>Age</th>
          <th>AMH</th>
          <th class="hide-mobile">Cycle</th>
          <th>Computed Age</th>
          <th class="hide-mobile">Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (leads.length === 0) { %>
          <tr><td colspan="8" class="adm-empty">No gate hits yet.</td></tr>
        <% } %>
        <% leads.forEach(function(l) { %>
        <tr>
          <td class="mono"><%= l.id %></td>
          <td><strong><%= l.consumer_name || '—' %></strong><br><span style="font-size:12px;color:var(--stone);"><%= l.consumer_email || '—' %></span></td>
          <td class="hide-mobile"><%= l.profile_name || '—' %></td>
          <td><%= l.age || '—' %></td>
          <td><%= l.amh || '—' %> ng/mL</td>
          <td class="hide-mobile"><%= l.cycle_regularity === 'R' ? 'Regular' : 'Irregular' %></td>
          <td><span class="badge badge-grey"><%= l.forecast_age %></span></td>
          <td class="mono hide-mobile"><%= l.created_at ? l.created_at.slice(0,16).replace('T',' ') : '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

</div>

<script>
function filterTable() {
  var q = document.getElementById('search-input').value.toLowerCase();
  document.querySelectorAll('#data-table tbody tr').forEach(function(row) {
    row.style.display = row.textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
  });
}
</script>

<%- include('partials/footer') %>

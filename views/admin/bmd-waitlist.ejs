<%- include('partials/header', {
  pageTitle: 'BMD Waitlist',
  activeTab: 'bmd-waitlist',
  userCount: locals.userCount || 0,
  orderCount: locals.orderCount || 0,
  resultCount: locals.resultCount || 0,
  bmdCount: locals.bmdCount || 0,
  leadCount: locals.leadCount || 0,
  waitCount: rows.length
}) %>

<div class="adm-body">

  <div class="adm-stats">
    <div class="adm-stat">
      <div class="adm-stat-label">On the Waitlist</div>
      <div class="adm-stat-value"><%= rows.length %></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-label">Reachable by WhatsApp</div>
      <div class="adm-stat-value"><%= rows.filter(function(r){ return r.waLink; }).length %></div>
    </div>
  </div>

  <div class="adm-section-header">
    <h1 class="adm-section-title">BMD Calculator Waitlist</h1>
    <div class="adm-section-spacer"></div>
    <div class="adm-search">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="search-input" placeholder="Search by email or phone…" oninput="filterTable()" autocomplete="off">
    </div>
    <a href="/admin/bmd-waitlist?export=csv" class="adm-export">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Export CSV
    </a>
  </div>

  <p class="adm-note">
    People who asked to be told when the BMD Calculator comes back. The calculator
    itself is retired while its model is recalibrated — see the BMD tab for the
    historical records, which are untouched.
  </p>

  <div class="adm-table-wrap">
    <table class="adm-table" id="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Email</th>
          <th>Phone</th>
          <th class="hide-mobile">Signed up</th>
          <th>Follow-up</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
        <tr><td colspan="5" style="text-align:center;color:var(--stone);padding:28px 0;">Nobody has signed up yet.</td></tr>
        <% } %>
        <% rows.forEach(function(r) { %>
        <tr>
          <td class="mono"><%= r.id %></td>
          <td><strong><%= r.email %></strong></td>
          <td class="mono"><%= r.phone || '—' %></td>
          <td class="mono hide-mobile"><%= r.created_at ? r.created_at.slice(0,16).replace('T',' ') : '—' %></td>
          <td>
            <% if (r.waLink) { %>
              <a href="<%= r.waLink %>" target="_blank" rel="noopener" class="adm-export" style="white-space:nowrap;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.13-2.9-7C17.18 3.03 14.69 2 12.04 2z"/></svg>
                Message
              </a>
            <% } else { %>
              <span style="font-size:12px;color:var(--stone);">No phone on file</span>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

</div>

<script>
function filterTable() {
  var q = document.getElementById('search-input').value.toLowerCase();
  var rows = document.querySelectorAll('#data-table tbody tr');
  for (var i = 0; i < rows.length; i++) {
    rows[i].style.display = rows[i].textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
  }
}
</script>

<%- include('partials/footer') %>

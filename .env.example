# ═══════════════════════════════════════════════════════════════════════════
# e-healthwatch — environment variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env for local development, or set these in your host's
# dashboard (Vercel → Settings → Environment Variables) for production.
#
# .env is gitignored. Never commit real values.
#
# Nothing here crashes the app when missing — every secret degrades to a clear,
# safe behaviour instead. The "if unset" note on each says what you lose.
# ═══════════════════════════════════════════════════════════════════════════


# ─── 1. Core (set these first) ─────────────────────────────────────────────

# Signs session cookies. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset: a new random secret is generated per boot, so every user is logged
# out on every restart and on every serverless cold start.
SESSION_SECRET=

# Public base URL, no trailing slash, e.g. https://e-healthwatch.com
# Used for canonical link tags, og:image, robots.txt and sitemap.xml.
# If unset: falls back to the request's own host, which is fine locally but
# will publish preview-deployment URLs to search engines in production.
APP_BASE_URL=

# Password for /admin. Compared in constant time.
# If unset: admin login is refused outright — it does NOT fall open.
ADMIN_PASSWORD=


# ─── 2. Database (Turso) ───────────────────────────────────────────────────

# libsql://your-db-name-org.turso.io
# If unset: falls back to a local SQLite file (see DB_PATH). That is correct
# for development and WRONG for production on Vercel, where the filesystem is
# ephemeral — every deploy would silently discard all user data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# ─── 3. Payments (Razorpay) ────────────────────────────────────────────────

# Test keys start rzp_test_, live keys rzp_live_. Switch to live before launch.
# If unset: the site runs normally but checkout shows "Payments are not
# configured on this server" instead of failing part-way through a charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set the same value in the Razorpay dashboard when registering the webhook.
# Webhook URL: https://YOUR_DOMAIN/razorpay-webhook   (event: payment.captured)
# If unset: the webhook endpoint returns 503 and rejects every call rather than
# trusting an unverified payload. Payments still complete via the browser
# redirect, but you lose the server-to-server confirmation.
RAZORPAY_WEBHOOK_SECRET=


# ─── 4. Email (Gmail app password) ─────────────────────────────────────────

# Not your Gmail password — an App Password from a 2FA-enabled account:
# Google Account → Security → 2-Step Verification → App passwords.
# If unset: contact enquiries are still SAVED and flagged "not emailed" in
# /admin/messages, but password-reset emails cannot be delivered at all.
GMAIL_USER=
GMAIL_APP_PASSWORD=


# ─── 5. Published business details ─────────────────────────────────────────
# Razorpay onboarding (RBI Payment Aggregator Guidelines) requires a working
# phone number, email address and registered address to be displayed on the
# site. These have NO placeholder fallback on purpose: anything left blank
# simply does not render, so the site can never publish fake contact details.
# Leaving these unset means NO contact details appear anywhere.

BUSINESS_NAME=e-healthwatch
BUSINESS_EMAIL=
BUSINESS_PHONE=

# Use \n between lines, e.g. "12 Anna Salai\nChennai 600002, India"
BUSINESS_ADDRESS=


# ─── 6. Rarely needed ──────────────────────────────────────────────────────

# Port for the local server. Ignored on Vercel, which assigns its own.
# If unset: 5000.
PORT=5000

# Path to the local SQLite file. Ignored when TURSO_DATABASE_URL is set.
# Mainly useful for pointing tests at an isolated database.
# If unset: ./ehealthwatch.db
DB_PATH=

# Set to "production" on your live deployment. Vercel sets this automatically,
# so you normally do NOT need to add it yourself.
# Controls one security behaviour: outside production, when email is not
# configured, password-reset links are printed to the server log so you can
# complete a reset locally. In production that is suppressed, because server
# logs are retained and a logged reset link would be an account-takeover path.
NODE_ENV=


# ─── 7. Analytics (optional) ───────────────────────────────────────────────

# Microsoft Clarity project ID, from clarity.microsoft.com → Settings → Setup.
# If unset: no analytics script loads at all, and the analytics section of the
# privacy policy is hidden, so the policy never describes tracking you aren't
# doing.
#
# Before enabling on a health site, in the Clarity dashboard:
#   Settings → Masking → set mode to STRICT (default is Balanced, which only
#   masks numbers and emails — a forecast age is a number, so Balanced is not
#   sufficient here).
# Form inputs and dropdowns are masked by Clarity in every mode. Result pages
# and reports carry data-clarity-mask in the templates. Admin never loads it.
CLARITY_PROJECT_ID=

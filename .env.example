# Copy to .env for local development, or set these in your host's dashboard.
# .env is gitignored — never commit real values.

# ─── Required in production ──────────────────────────────────────────────────
SESSION_SECRET=            # long random string; without it sessions reset on every cold start
TURSO_DATABASE_URL=        # libsql://... ; omit locally to use a SQLite file
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=            # admin panel; login is refused outright if unset
APP_BASE_URL=              # https://yourdomain.com — used for canonical URLs, og:image, sitemap

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Without these the site runs but checkout shows "Payments are not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # webhook returns 503 until this is set

# ─── Email (Gmail app password) ──────────────────────────────────────────────
# Without these, contact enquiries are still stored and flagged "not emailed",
# and password resets cannot be delivered.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Published business details ──────────────────────────────────────────────
# Razorpay onboarding (RBI Payment Aggregator Guidelines) requires a working
# phone, email and registered address on the site. There is no fallback: any
# value left blank simply does not render, so nothing fake is ever published.
BUSINESS_NAME=e-healthwatch
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=          # use \n for line breaks
